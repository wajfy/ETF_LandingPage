# Lead form / email delivery – server-side only. Copy to .env.local for local overrides.
# NEVER commit real values. .env and .env.* (except this file) are git-ignored.
# None of these are VITE_-prefixed, so Vite never exposes them to the browser.

# ---------------------------------------------------------------------------------------------
# MOCK MODE (default). Leave everything below commented out for local development:
# nothing is sent, nothing is stored on disk; preview generated emails at /api/dev/outbox.
# ---------------------------------------------------------------------------------------------
# EMAIL_DELIVERY_MODE=mock

# ---------------------------------------------------------------------------------------------
# REAL DELIVERY VIA RESEND. All of the following are required; if any is missing the endpoint
# refuses to run (HTTP 503) instead of falling back to mock. Do not enable before the launch
# blockers in README §8 are resolved.
# ---------------------------------------------------------------------------------------------
# EMAIL_DELIVERY_MODE=resend
# EMAIL_DELIVERY_CONFIRM=send-real-emails
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Prověrka ETF <srovnani@vase-overena-domena.cz>"
# EMAIL_REPLY_TO=kontakt@vase-overena-domena.cz
# EMAIL_OPERATOR_LINE="Provozovatel: Název s.r.o., Ulice 1, 110 00 Praha, IČO 12345678, kontakt@vase-overena-domena.cz"
# ALLOWED_ORIGINS=https://vase-overena-domena.cz

# Optional: provider timeout in ms (1000–15000, default 10000). Must stay below the browser
# timeout (20 s) and the function limit in vercel.json (25 s).
# EMAIL_PROVIDER_TIMEOUT_MS=10000
